    {
      "phase": 1,
      "name": "Bot elimination and ticker extraction",
      "what": "Drops posts from accounts under 30 days old, with under 3 followers, posting more than 5 times a minute, or copy-pasting the same text. Finds tickers from cashtags, exchange tags and company names, limited to US common stocks (NYSE, Nasdaq, NYSE American)."
    },
    {
      "phase": 2,
      "name": "Market and volume hard filters",
      "what": "Requires market cap of at least $300M, price above $1, real trading liquidity and history; no SPACs. Chatter must be unusual (z-score), come from many different users (70%+ unique), and be confirmed by real trading volume. Fundamentals: positive P/E up to 60, growing revenue, debt/equity up to 200%."
    },
    {
      "phase": 3,
      "name": "Sentiment scoring",
      "what": "Normalises emojis and slang, isolates each ticker in multi-ticker posts, scores with FinBERT plus a trader-slang dictionary, one vote per user."
    },
    {
      "phase": 4,
      "name": "AI catalyst and sarcasm review",
      "what": "An LLM explains why each stock is discussed and must cite real headlines. Hype, meme and spam driven interest, negative or minor catalysts are rejected; sarcastic posts are re-scored."
    },
    {
      "phase": 5,
      "name": "Risk checks and diversification",
      "what": "Removes stocks that already jumped over 20% in 5 days, are very overbought or very volatile; flags earnings within 7 days and high short interest; max 2 per sector and no near-duplicates."
    }
